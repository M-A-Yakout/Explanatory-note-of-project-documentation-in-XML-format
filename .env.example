# Copy to .env and fill in. Generate secrets with:  openssl rand -hex 32
# Use URL-safe characters in POSTGRES_PASSWORD (hex is fine): it is embedded in a database URL.
POSTGRES_PASSWORD=
SECRET_KEY=

# First super administrator (created once on first start)
SEED_ADMIN_EMAIL=admin@your-company.ru
SEED_ADMIN_PASSWORD=

# Public address of the site (used in links inside e-mails) and the port published by nginx
PUBLIC_URL=http://localhost
HTTP_PORT=80

# Optional
REQUIRE_EMAIL_CONFIRMATION=false
WEB_CONCURRENCY=2
